{
  "title": "Undercontroll Observability",
  "uid": "undercontroll-observability",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Requests / Min",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m]))" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Errors (4xx)",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[5m]))"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Errors (5xx)",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "graph",
      "title": "HTTP Latency (p99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))"
        }
      ],
      "legend": { "show": true },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Memory Usage (Heap)",
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}" },
        { "expr": "jvm_memory_max_bytes{area=\"heap\"}" }
      ],
      "legend": { "show": true },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "GC Pause",
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum[5m])" }
      ],
      "legend": { "show": true },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Active Threads",
      "targets": [
        { "expr": "jvm_threads_live_threads" }
      ],
      "legend": { "show": true },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "HikariCP Connections",
      "targets": [
        { "expr": "hikaricp_connections_active" },
        { "expr": "hikaricp_connections_idle" }
      ],
      "legend": { "show": true },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Custom Metric: Announcement Created",
      "targets": [
        { "expr": "announcement_created_count" }
      ],
      "legend": { "show": true },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 }
    }
  ]
}
